NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AES-256 key for receipt encryption (generate: openssl rand -hex 32)
RECEIPT_ENCRYPTION_KEY=

# USCIS API (sandbox/live). Default mode is stub for local/demo.
USCIS_API_MODE=stub
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
# USCIS_TOKEN_URL=https://api-int.uscis.gov/oauth/accesstoken
# USCIS_CASE_STATUS_URL=https://api-int.uscis.gov/case-status

# Resend transactional email
RESEND_API_KEY=
# RESEND_FROM=notifications@eb5base.com

# Protect cron routes in production (Authorization: Bearer ...)
CRON_SECRET=

# Site-wide maintenance page (default OFF — site is public).
# Set MAINTENANCE_MODE=true to pause the directory for visitors.
# Optional private unlock while paused: set a secret and open /?access=SECRET
# MAINTENANCE_MODE=true
# MAINTENANCE_BYPASS_SECRET=some-long-random-string
# MAINTENANCE_MODE=false

# regulations.gov / api.data.gov (NPRM comment pull)
# Get a key at https://api.data.gov/signup/
REGULATIONS_GOV_API_KEY=
