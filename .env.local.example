NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AES-256 key for receipt encryption (generate: openssl rand -hex 32)
RECEIPT_ENCRYPTION_KEY=

# USCIS API (sandbox/live). Default mode is stub for local/demo.
USCIS_API_MODE=stub
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
# USCIS_TOKEN_URL=https://api-int.uscis.gov/oauth/accesstoken
# USCIS_CASE_STATUS_URL=https://api-int.uscis.gov/case-status

# Resend transactional email
RESEND_API_KEY=
# RESEND_FROM=notifications@eb5base.com

# Protect cron routes in production (Authorization: Bearer ...)
CRON_SECRET=

# Site-wide maintenance page (default ON if unset).
# Public sees the pause page. For private unlock (you + counsel), set a secret and open /?access=SECRET
# MAINTENANCE_BYPASS_SECRET=some-long-random-string
# Set MAINTENANCE_MODE=false when tools should be public.
# MAINTENANCE_MODE=false
